@@ -0,0 +1,96 @@
+/*---------------------------------------------------------*\
+| SinowealthKeyboard49Controller.h                          |
+|                                                           |
+|   Driver for Sinowealth keyboards with PID 0049 that      |
+|   answer the model probe (Redragon K636)                  |
+|                                                           |
+|   tdulshan                                    03 Nov 2026 |
+|                                                           |
+|   This file is part of the OpenRGB project                |
+|   SPDX-License-Identifier: GPL-2.0-or-later               |
+\*---------------------------------------------------------*/
+
+#pragma once
+
+#include <chrono>
+#include <mutex>
+#include <string>
+#include <vector>
+#include <hidapi.h>
+
+/*---------------------------------------------------------*\
+| Model IDs, the last byte of the probe reply               |
+\*---------------------------------------------------------*/
+#define SINOWEALTH_49_MODEL_K636            0x5D
+
+/*---------------------------------------------------------*\
+| Mode values (config byte 0x15)                            |
+|   0x00        Direct: the keyboard is dark and shows the  |
+|               live frames sent with report 8              |
+|   0x01-0x14   Onboard effects                             |
+\*---------------------------------------------------------*/
+#define SINOWEALTH_49_MODE_DIRECT           0x00
+#define SINOWEALTH_49_EFFECT_COUNT          20
+
+/*---------------------------------------------------------*\
+| Per-effect settings: colour flag 0-6 picks a colour from  |
+| the effect's 7-colour palette, 7 is multicolour; speed    |
+| and brightness are 0-4 (higher is faster / brighter)      |
+\*---------------------------------------------------------*/
+#define SINOWEALTH_49_COLOR_RANDOM          0x07
+#define SINOWEALTH_49_PALETTE_SIZE          7
+
+/*---------------------------------------------------------*\
+| Palette block: entry m (effect m) holds 7 RGB colours at  |
+| offset 21 * m                                             |
+\*---------------------------------------------------------*/
+#define SINOWEALTH_49_PALETTE_BLOCK_SIZE    1024
+#define SINOWEALTH_49_PALETTE_ENTRY_SIZE    (SINOWEALTH_49_PALETTE_SIZE * 3)
+#define SINOWEALTH_49_SPEED_MAX             4
+#define SINOWEALTH_49_BRIGHTNESS_MIN        1
+#define SINOWEALTH_49_BRIGHTNESS_MAX        4
+
+/*---------------------------------------------------------*\
+| Live frames: 6 x 21 key matrix, column-major, RGB         |
+\*---------------------------------------------------------*/
+#define SINOWEALTH_49_MATRIX_ROWS           6
+#define SINOWEALTH_49_MATRIX_COLS           21
+#define SINOWEALTH_49_FRAME_SIZE            (SINOWEALTH_49_MATRIX_ROWS * SINOWEALTH_49_MATRIX_COLS * 3)
+
+typedef struct
+{
+    unsigned char   color_flag;
+    unsigned char   speed;
+    unsigned char   brightness;
+} sinowealth_49_effect_settings;
+
+class SinowealthKeyboard49Controller
+{
+public:
+    SinowealthKeyboard49Controller(hid_device* dev_handle, const char* path, std::string dev_name);
+    ~SinowealthKeyboard49Controller();
+
+    static unsigned char ProbeModel(hid_device* dev);
+
+    std::string GetLocation();
+    std::string GetName();
+    std::string GetSerialString();
+
+    bool        ReadState(unsigned char* mode, sinowealth_49_effect_settings* effects);
+    bool        ReadPalette(unsigned char* palette);
+    bool        SetMode(unsigned char mode, const sinowealth_49_effect_settings* effect, const unsigned char* palette = nullptr);
+    void        WaitForFrameSlot();
+    void        SendFrame(const std::vector<unsigned char>& frame);
+
+private:
+    hid_device*                                         dev;
+    std::string                                         location;
+    std::string                                         name;
+    std::mutex                                          dev_mutex;
+    std::chrono::time_point<std::chrono::steady_clock>  last_frame_time;
+    std::chrono::time_point<std::chrono::steady_clock>  last_block_time;
+
+    void        WaitForBlockWrite();
+    bool        ReadConfig(unsigned char* buf);
+    bool        WriteConfig(unsigned char* buf);
+};
