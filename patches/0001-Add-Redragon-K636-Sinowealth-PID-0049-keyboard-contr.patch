+
+class RGBController_SinowealthKeyboard49 : public RGBController
+{
+public:
+    RGBController_SinowealthKeyboard49(SinowealthKeyboard49Controller* controller_ptr, std::function<void()> shutdown_callback);
+    ~RGBController_SinowealthKeyboard49();
+
+    void SetupZones();
+
+    void DeviceUpdateLEDs();
+    void DeviceUpdateZoneLEDs(int zone);
+    void DeviceUpdateSingleLED(int led);
+
+    void DeviceUpdateMode();
+
+private:
+    typedef struct
+    {
+        unsigned int    generation;
+        unsigned char   mode;
+        bool            has_speed;
+        unsigned char   speed;
+        unsigned char   brightness;
+        bool            random;
+        RGBColor        color;
+    } effect_request;
+
+    SinowealthKeyboard49Controller* controller;
+    std::function<void()>           shutdown_callback;
+
+    /*-----------------------------------------------------*\
+    | What the keyboard holds, to skip writes that would    |
+    | not change anything                                   |
+    \*-----------------------------------------------------*/
+    std::mutex                      state_mutex;
+    unsigned char                   device_mode;
+    sinowealth_49_effect_settings   device_effects[SINOWEALTH_49_EFFECT_COUNT];
+    unsigned char                   device_palette[SINOWEALTH_49_PALETTE_BLOCK_SIZE];
+    bool                            palette_known;
+
+    /*-----------------------------------------------------*\
+    | Effect changes wait in a writer thread until they     |
+    | stop changing, so that dragging a slider or the       |
+    | colour wheel writes the keyboard's memory once        |
+    \*-----------------------------------------------------*/
+    std::thread                             writer_thread;
+    std::mutex                              writer_mutex;
+    std::condition_variable                 writer_cv;
+    bool                                    writer_run;
+    bool                                    request_pending;
+    effect_request                          request;
+    std::chrono::steady_clock::time_point   request_time;
+    std::atomic<unsigned int>               update_generation;
+
+    void        WriterThreadFunction();
+    void        ApplyEffect(const effect_request& req);
+    RGBColor    PaletteColor(unsigned char effect, unsigned char slot);
+};
diff --git a/Controllers/SinowealthController/SinowealthKeyboard49Controller/SinowealthKeyboard49Controller.cpp b/Controllers/SinowealthController/SinowealthKeyboard49Controller/SinowealthKeyboard49Controller.cpp
new file mode 100644
index 00000000..a8c62b7e
--- /dev/null
+++ b/Controllers/SinowealthController/SinowealthKeyboard49Controller/SinowealthKeyboard49Controller.cpp
@@ -0,0 +1,373 @@
+/*---------------------------------------------------------*\
+| SinowealthKeyboard49Controller.cpp                        |
+|                                                           |
+|   Driver for Sinowealth keyboards with PID 0049 that      |
+|   answer the model probe (Redragon K636)                  |
+|                                                           |
+|   tdulshan                                    03 Nov 2026 |
+|                                                           |
+|   This file is part of the OpenRGB project                |
+|   SPDX-License-Identifier: GPL-2.0-or-later               |
+\*---------------------------------------------------------*/
+
+#include <algorithm>
+#include <cstring>
+#include <thread>
+#include "SinowealthKeyboard49Controller.h"
+#include "StringUtils.h"
+
+/*---------------------------------------------------------*\
+| Everything below repeats packets captured from the        |
+| vendor app.  PID 0049 is shared with keyboards that were  |
+| bricked by a driver that wrote a fixed config image, so   |
+| the config block is only ever read, changed in place and  |
+| written back.                                             |
+|                                                           |
+| Report 5 (6 bytes):    commands                           |
+| Report 6 (1032 bytes): config block, 06 83 B6 on read     |
+|                        and 06 03 B6 on write; palette     |
+|                        block, 06 08 B8 00 40 on write     |
+| Report 8 (382 bytes):  live frame, 08 0A 7A 01 + RGB      |
+\*---------------------------------------------------------*/
+#define REPORT_COMMAND                  0x05
+#define REPORT_DATA                     0x06
+#define REPORT_FRAME                    0x08
+
+#define COMMAND_SIZE                    6
+#define PROBE_REPLY_SIZE                8
+#define DATA_SIZE                       1032
+#define FRAME_HEADER_SIZE               4
+
+#define BLOCK_HEADER_SIZE               8
+
+#define CONFIG_ADDRESS                  0xB6
+#define CONFIG_READ                     0x83
+#define CONFIG_WRITE                    0x03
+
+#define PALETTE_ADDRESS                 0xB8
+#define PALETTE_READ                    0x88
+#define PALETTE_WRITE                   0x08
+
+/*---------------------------------------------------------*\
+| Config block offsets, counting the report ID byte         |
+\*---------------------------------------------------------*/
+#define CONFIG_MIN_SIZE                 0x8B
+#define CONFIG_CUSTOM_FLAG              0x14
+#define CONFIG_MODE                     0x15
+#define CONFIG_EFFECT_TABLE             0x26
+
+#define CONFIG_MARKER_COUNT             3
+
+static const unsigned char config_markers[CONFIG_MARKER_COUNT] = { 0x0E, 0x4E, 0x89 };
+static const unsigned char probe_command[COMMAND_SIZE]      = { REPORT_COMMAND, 0x05, 0x81, 0x00, 0x00, 0x00 };
+static const unsigned char probe_reply_prefix[]             = { REPORT_COMMAND, 0x01, 0x02, 0x00, 0x00, 0x00, 0x01 };
+static const unsigned char frame_header[FRAME_HEADER_SIZE]  = { REPORT_FRAME, 0x0A, 0x7A, 0x01 };
+
+/*---------------------------------------------------------*\
+| The vendor app waits about 20 ms after each packet, and   |
+| about 60 ms after a block write (config, palette).  The   |
+| keyboard is busy storing a block for a while and drops    |
+| packets that arrive meanwhile: nothing is sent within     |
+| BLOCK_SETTLE of a block write, and live frames wait       |
+| longer.  Frames are paced for about 60 fps: the keyboard  |
+| takes one in about 4 ms and shows frames sent every 10 ms |
+\*---------------------------------------------------------*/
+#define PACKET_DELAY                    std::chrono::milliseconds(20)
+#define BLOCK_SETTLE                    std::chrono::milliseconds(100)
+#define FRAME_PERIOD                    std::chrono::milliseconds(16)
+#define FRAME_SETTLE                    std::chrono::milliseconds(200)
+
+SinowealthKeyboard49Controller::SinowealthKeyboard49Controller(hid_device* dev_handle, const char* path, std::string dev_name)
+{
+    dev             = dev_handle;
+    location        = path;
+    name            = dev_name;
+    last_frame_time  = std::chrono::steady_clock::now() - FRAME_PERIOD;
+    last_block_time = std::chrono::steady_clock::now() - FRAME_SETTLE;
+}
+
+/*---------------------------------------------------------*\
+| Wait until the last block write has been stored           |
+\*---------------------------------------------------------*/
+void SinowealthKeyboard49Controller::WaitForBlockWrite()
+{
+    std::this_thread::sleep_until(last_block_time + BLOCK_SETTLE);
+}
+
+SinowealthKeyboard49Controller::~SinowealthKeyboard49Controller()
+{
+    hid_close(dev);
+}
+
+/*---------------------------------------------------------*\
+| Model probe, as sent by the vendor app at launch.  The    |
+| reply is read with a length of 8 although report 5 is     |
+| declared as 6 bytes.  Returns 0 when the reply does not   |
+| have the expected form.                                   |
+\*---------------------------------------------------------*/
+unsigned char SinowealthKeyboard49Controller::ProbeModel(hid_device* dev)
+{
+    unsigned char reply[PROBE_REPLY_SIZE] = { REPORT_COMMAND };
+
+    if(hid_send_feature_report(dev, probe_command, COMMAND_SIZE) < 0)
+    {
+        return(0);
+    }
+
+    std::this_thread::sleep_for(PACKET_DELAY);
+
+    int len = hid_get_feature_report(dev, reply, PROBE_REPLY_SIZE);
+
+    std::this_thread::sleep_for(PACKET_DELAY);
+
+    if(len != PROBE_REPLY_SIZE || memcmp(reply, probe_reply_prefix, sizeof(probe_reply_prefix)) != 0)
+    {
+        return(0);
+    }
+
+    return(reply[PROBE_REPLY_SIZE - 1]);
+}
+
+std::string SinowealthKeyboard49Controller::GetLocation()
+{
+    return("HID: " + location);
+}
+
+std::string SinowealthKeyboard49Controller::GetName()
+{
+    return(name);
+}
+
+std::string SinowealthKeyboard49Controller::GetSerialString()
+{
+    wchar_t serial_string[128];
+    int     ret = hid_get_serial_number_string(dev, serial_string, 128);
+
+    if(ret != 0)
+    {
+        return("");
+    }
+
+    return(StringUtils::wstring_to_string(serial_string));
+}
+
+/*---------------------------------------------------------*\
+| Read the active mode and the settings of every effect     |
+\*---------------------------------------------------------*/
+bool SinowealthKeyboard49Controller::ReadState(unsigned char* mode, sinowealth_49_effect_settings* effects)
+{
+    std::lock_guard<std::mutex> lock(dev_mutex);
+    unsigned char               buf[DATA_SIZE];
+
+    if(!ReadConfig(buf))
+    {
+        return(false);
+    }
+
+    *mode = buf[CONFIG_MODE];
+
+    for(unsigned int i = 0; i < SINOWEALTH_49_EFFECT_COUNT; i++)
+    {
+        effects[i].color_flag   = buf[CONFIG_EFFECT_TABLE + 2 * i];
+        effects[i].speed        = buf[CONFIG_EFFECT_TABLE + 2 * i + 1] >> 4;
+        effects[i].brightness   = buf[CONFIG_EFFECT_TABLE + 2 * i + 1] & 0x0F;
+    }
+
+    return(true);
+}
+
+/*---------------------------------------------------------*\
+| Read the palette block (SINOWEALTH_49_PALETTE_BLOCK_SIZE  |
+| bytes).  The vendor app never reads it; this is the read  |
+| the PID 0016 driver uses for its colour block, and on the |
+| K636 it returned exactly the palette the app had written. |
+| The reply does not echo the block address.                |
+\*---------------------------------------------------------*/
+bool SinowealthKeyboard49Controller::ReadPalette(unsigned char* palette)
+{
+    std::lock_guard<std::mutex> lock(dev_mutex);
+    unsigned char               command[COMMAND_SIZE] = { REPORT_COMMAND, PALETTE_READ, PALETTE_ADDRESS, 0x00, 0x40, 0x00 };
+    unsigned char               buf[DATA_SIZE]        = { REPORT_DATA };
+
+    WaitForBlockWrite();
+
+    if(hid_send_feature_report(dev, command, COMMAND_SIZE) < 0)
+    {
+        return(false);
+    }
+
+    std::this_thread::sleep_for(PACKET_DELAY);
+
+    int len = hid_get_feature_report(dev, buf, DATA_SIZE);
+
+    std::this_thread::sleep_for(PACKET_DELAY);
+
+    if(len != DATA_SIZE || buf[0] != REPORT_DATA || buf[1] != PALETTE_READ)
+    {
+        return(false);
+    }
+
+    memcpy(palette, buf + BLOCK_HEADER_SIZE, SINOWEALTH_49_PALETTE_BLOCK_SIZE);
+
+    return(true);
+}
+
+/*---------------------------------------------------------*\
+| Switch to a mode.  For an onboard effect, effect holds    |
+| its new settings; for Direct it is ignored.  If palette   |
+| is given, the palette block is written first, as the      |
+| vendor app does.  Both blocks are kept across power       |
+| cycles, so callers should skip writes that change nothing |
+\*---------------------------------------------------------*/
+bool SinowealthKeyboard49Controller::SetMode(unsigned char mode, const sinowealth_49_effect_settings* effect, const unsigned char* palette)
+{
+    std::lock_guard<std::mutex> lock(dev_mutex);
+    unsigned char               buf[DATA_SIZE];
+
+    if(mode > SINOWEALTH_49_EFFECT_COUNT)
+    {
+        return(false);
+    }
+
+    if(!ReadConfig(buf))
+    {
+        return(false);
+    }
+
+    if(palette != nullptr)
+    {
+        unsigned char palette_buf[DATA_SIZE] = { REPORT_DATA, PALETTE_WRITE, PALETTE_ADDRESS, 0x00, 0x40 };
+
+        memcpy(palette_buf + BLOCK_HEADER_SIZE, palette, SINOWEALTH_49_PALETTE_BLOCK_SIZE);
+
+        if(hid_send_feature_report(dev, palette_buf, DATA_SIZE) < 0)
+        {
+            return(false);
+        }
+
+        last_block_time = std::chrono::steady_clock::now();
+
+        WaitForBlockWrite();
+    }
+
+    buf[CONFIG_CUSTOM_FLAG] = 0x00;
+    buf[CONFIG_MODE]        = mode;
+
+    if(mode != SINOWEALTH_49_MODE_DIRECT && effect != nullptr)
+    {
+        unsigned char color_flag = std::min(effect->color_flag, (unsigned char)SINOWEALTH_49_COLOR_RANDOM);
+        unsigned char speed      = std::min(effect->speed,      (unsigned char)SINOWEALTH_49_SPEED_MAX);
+        unsigned char brightness = std::clamp(effect->brightness, (unsigned char)SINOWEALTH_49_BRIGHTNESS_MIN, (unsigned char)SINOWEALTH_49_BRIGHTNESS_MAX);
+
+        buf[CONFIG_EFFECT_TABLE + 2 * (mode - 1)]       = color_flag;
+        buf[CONFIG_EFFECT_TABLE + 2 * (mode - 1) + 1]   = (speed << 4) | brightness;
+    }
+
+    return(WriteConfig(buf));
+}
+
+/*---------------------------------------------------------*\
+| Wait until the keyboard can take the next live frame.     |
+| Call this before building a frame, so that the frame      |
+| holds the newest colours when it is sent                  |
+\*---------------------------------------------------------*/
+void SinowealthKeyboard49Controller::WaitForFrameSlot()
+{
+    std::chrono::time_point<std::chrono::steady_clock> slot;
+
+    {
+        std::lock_guard<std::mutex> lock(dev_mutex);
+        slot = std::max(last_frame_time + FRAME_PERIOD, last_block_time + FRAME_SETTLE);
+    }
+
+    std::this_thread::sleep_until(slot);
+}
+
+/*---------------------------------------------------------*\
+| Send one live frame (Direct mode).  The keyboard keeps    |
+| showing the last frame, so no keepalive is needed         |
+\*---------------------------------------------------------*/
+void SinowealthKeyboard49Controller::SendFrame(const std::vector<unsigned char>& frame)
+{
+    std::lock_guard<std::mutex> lock(dev_mutex);
+    unsigned char               buf[FRAME_HEADER_SIZE + SINOWEALTH_49_FRAME_SIZE] = {};
+
+    if(frame.size() != SINOWEALTH_49_FRAME_SIZE)
+    {
+        return;
+    }
+
+    memcpy(buf, frame_header, FRAME_HEADER_SIZE);
+    memcpy(buf + FRAME_HEADER_SIZE, frame.data(), SINOWEALTH_49_FRAME_SIZE);
+
+    std::this_thread::sleep_until(std::max(last_frame_time + FRAME_PERIOD, last_block_time + FRAME_SETTLE));
+
+    hid_send_feature_report(dev, buf, sizeof(buf));
+
+    last_frame_time = std::chrono::steady_clock::now();
+}
+
+/*---------------------------------------------------------*\
+| Read the config block into buf (DATA_SIZE bytes, zero     |
+| after the bytes the keyboard returns) and check it        |
+\*---------------------------------------------------------*/
+bool SinowealthKeyboard49Controller::ReadConfig(unsigned char* buf)
+{
+    unsigned char command[COMMAND_SIZE] = { REPORT_COMMAND, CONFIG_READ, CONFIG_ADDRESS, 0x00, 0x00, 0x00 };
+
+    memset(buf, 0x00, DATA_SIZE);
+
+    WaitForBlockWrite();
+
+    if(hid_send_feature_report(dev, command, COMMAND_SIZE) < 0)
+    {
+        return(false);
+    }
+
+    std::this_thread::sleep_for(PACKET_DELAY);
+
+    buf[0]  = REPORT_DATA;
+    int len = hid_get_feature_report(dev, buf, DATA_SIZE);
+
+    std::this_thread::sleep_for(PACKET_DELAY);
+
+    if(len < CONFIG_MIN_SIZE || buf[0] != REPORT_DATA || buf[1] != CONFIG_READ || buf[2] != CONFIG_ADDRESS)
+    {
+        return(false);
+    }
+
+    for(unsigned int i = 0; i < CONFIG_MARKER_COUNT; i++)
+    {
+        if(buf[config_markers[i]] != 0x5A || buf[config_markers[i] + 1] != 0xA5)
+        {
+            return(false);
+        }
+    }
+
+    return(true);
+}
+
+/*---------------------------------------------------------*\
+| Write back a block read by ReadConfig: the same bytes,    |
+| with the read command replaced by the write command       |
+\*---------------------------------------------------------*/
+bool SinowealthKeyboard49Controller::WriteConfig(unsigned char* buf)
+{
+    for(unsigned int i = 0; i < CONFIG_MARKER_COUNT; i++)
+    {
+        if(buf[config_markers[i]] != 0x5A || buf[config_markers[i] + 1] != 0xA5)
+        {
+            return(false);
+        }
+    }
+
+    buf[1] = CONFIG_WRITE;
+
+    int ret = hid_send_feature_report(dev, buf, DATA_SIZE);
+
+    last_block_time = std::chrono::steady_clock::now();
+
+    std::this_thread::sleep_for(PACKET_DELAY);
+
+    return(ret >= 0);
+}
