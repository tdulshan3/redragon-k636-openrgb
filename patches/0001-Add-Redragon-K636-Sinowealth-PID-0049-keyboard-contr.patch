+/*---------------------------------------------------------*\
+| RGBController_SinowealthKeyboard49.cpp                    |
+|                                                           |
+|   RGBController for Sinowealth keyboards with PID 0049    |
+|   that answer the model probe (Redragon K636)             |
+|                                                           |
+|   tdulshan                                    03 Nov 2026 |
+|                                                           |
+|   This file is part of the OpenRGB project                |
+|   SPDX-License-Identifier: GPL-2.0-or-later               |
+\*---------------------------------------------------------*/
+
+#include <algorithm>
+#include <climits>
+#include <cstring>
+#include "RGBControllerKeyNames.h"
+#include "RGBController_SinowealthKeyboard49.h"
+
+#define NA                      0xFFFFFFFF
+#define K636_MATRIX_COLS        17      /* columns 17-20 of the key matrix are unused */
+
+/*---------------------------------------------------------*\
+| The palette the vendor app writes for every effect, in    |
+| colour flag order.  Used only if the keyboard's palette   |
+| cannot be read.                                           |
+\*---------------------------------------------------------*/
+static const RGBColor default_palette[SINOWEALTH_49_PALETTE_SIZE] =
+{
+    ToRGBColor(0xFF, 0x00, 0x00),
+    ToRGBColor(0x00, 0x00, 0xFF),
+    ToRGBColor(0x00, 0xFF, 0x00),
+    ToRGBColor(0xFF, 0xFF, 0x00),
+    ToRGBColor(0xFF, 0x00, 0xFF),
+    ToRGBColor(0x00, 0xFF, 0xFF),
+    ToRGBColor(0xFF, 0xFF, 0xFF),
+};
+
+/*---------------------------------------------------------*\
+| Onboard effects 0x01-0x14, named from how they look       |
+\*---------------------------------------------------------*/
+static const char* effect_names[SINOWEALTH_49_EFFECT_COUNT] =
+{
+    "Static",
+    "Breathing",
+    "Spectrum Cycle",
+    "Reactive Wave",
+    "Raindrop",
+    "Pinwheel",
+    "Reactive Ripple",
+    "Starlight",
+    "Reactive Fade",
+    "Snake",
+    "Wave",
+    "Reactive",
+    "Rainbow Wave",
+    "Wiper",
+    "Fan",
+    "Vertical Wave",
+    "Wave Out",
+    "Wave In",
+    "Crossing Wipers",
+    "Reactive Cross",
+};
+
+#define EFFECT_STATIC           0x01
+
+/*---------------------------------------------------------*\
+| How long an effect change must stay unchanged before it   |
+| is written                                                |
+\*---------------------------------------------------------*/
+#define EFFECT_WRITE_DELAY      std::chrono::milliseconds(300)
+
+static unsigned char NearestPaletteIndex(RGBColor color)
+{
+    unsigned char best          = 0;
+    int           best_distance = INT_MAX;
+
+    for(unsigned char i = 0; i < SINOWEALTH_49_PALETTE_SIZE; i++)
+    {
+        int dr       = (int)RGBGetRValue(color) - (int)RGBGetRValue(default_palette[i]);
+        int dg       = (int)RGBGetGValue(color) - (int)RGBGetGValue(default_palette[i]);
+        int db       = (int)RGBGetBValue(color) - (int)RGBGetBValue(default_palette[i]);
+        int distance = dr * dr + dg * dg + db * db;
+
+        if(distance < best_distance)
+        {
+            best          = i;
+            best_distance = distance;
+        }
+    }
+
+    return(best);
+}
+
+/**------------------------------------------------------------------*\
+    @name Redragon K636
+    @category Keyboard
+    @type USB
+    @save :robot:
+    @direct :white_check_mark:
+    @effects :white_check_mark:
+    @detectors DetectSinowealthKeyboard49
+    @comment PID 0049 is shared with other keyboards, so the detector
+        asks for the model ID first and only continues for the K636.
+\*-------------------------------------------------------------------*/
+
+RGBController_SinowealthKeyboard49::RGBController_SinowealthKeyboard49(SinowealthKeyboard49Controller* controller_ptr, std::function<void()> callback)
+{
+    controller        = controller_ptr;
+    shutdown_callback = callback;
+
+    name        = controller->GetName();
+    vendor      = "Redragon";
+    type        = DEVICE_TYPE_KEYBOARD;
+    description = "Sinowealth Keyboard Device (PID 0049)";
+    location    = controller->GetLocation();
+    serial      = controller->GetSerialString();
+
+    /*-----------------------------------------------------*\
+    | Start from what the keyboard holds, so that opening   |
+    | OpenRGB changes nothing                               |
+    \*-----------------------------------------------------*/
+    device_mode = 0xFF;
+
+    for(unsigned int i = 0; i < SINOWEALTH_49_EFFECT_COUNT; i++)
+    {
+        device_effects[i] = { SINOWEALTH_49_COLOR_RANDOM, 3, 3 };
+    }
+
+    if(!controller->ReadState(&device_mode, device_effects))
+    {
+        device_mode = 0xFF;
+    }
+
+    palette_known = controller->ReadPalette(device_palette);
+
+    mode Direct;
+    Direct.name       = "Direct";
+    Direct.value      = SINOWEALTH_49_MODE_DIRECT;
+    Direct.flags      = MODE_FLAG_HAS_PER_LED_COLOR;
+    Direct.color_mode = MODE_COLORS_PER_LED;
+    modes.push_back(Direct);
+
+    for(unsigned int i = 0; i < SINOWEALTH_49_EFFECT_COUNT; i++)
+    {
+        const sinowealth_49_effect_settings& settings = device_effects[i];
+
+        mode Effect;
+        Effect.name           = effect_names[i];
+        Effect.value          = i + 1;
+        Effect.flags          = MODE_FLAG_HAS_BRIGHTNESS | MODE_FLAG_HAS_MODE_SPECIFIC_COLOR | MODE_FLAG_HAS_RANDOM_COLOR | MODE_FLAG_AUTOMATIC_SAVE;
+        Effect.speed_min      = 0;
+        Effect.speed_max      = SINOWEALTH_49_SPEED_MAX;
+        Effect.brightness_min = SINOWEALTH_49_BRIGHTNESS_MIN;
+        Effect.brightness_max = SINOWEALTH_49_BRIGHTNESS_MAX;
+        Effect.colors_min     = 1;
+        Effect.colors_max     = 1;
+        Effect.speed          = std::min(settings.speed, (unsigned char)SINOWEALTH_49_SPEED_MAX);
+        Effect.brightness     = std::clamp(settings.brightness, (unsigned char)SINOWEALTH_49_BRIGHTNESS_MIN, (unsigned char)SINOWEALTH_49_BRIGHTNESS_MAX);
+        Effect.colors.resize(1);
+
+        if(Effect.value != EFFECT_STATIC)
+        {
+            Effect.flags |= MODE_FLAG_HAS_SPEED;
+        }
+
+        if(settings.color_flag < SINOWEALTH_49_PALETTE_SIZE)
+        {
+            Effect.color_mode = MODE_COLORS_MODE_SPECIFIC;
+            Effect.colors[0]  = PaletteColor(Effect.value, settings.color_flag);
+        }
+        else
+        {
+            Effect.color_mode = MODE_COLORS_RANDOM;
+            Effect.colors[0]  = PaletteColor(Effect.value, 0);
+        }
+
+        modes.push_back(Effect);
+    }
+
+    active_mode = 0;
+
+    for(unsigned int i = 0; i < modes.size(); i++)
+    {
+        if(modes[i].value == device_mode)
+        {
+            active_mode = i;
+        }
+    }
+
+    SetupZones();
+
+    update_generation = 0;
+    request_pending   = false;
+    writer_run        = true;
+    writer_thread     = std::thread(&RGBController_SinowealthKeyboard49::WriterThreadFunction, this);
+}
+
+RGBController_SinowealthKeyboard49::~RGBController_SinowealthKeyboard49()
+{
+    Shutdown();
+
+    /*-----------------------------------------------------*\
+    | Stop the writer, then write the last effect change    |
+    | if it is still waiting                                |
+    \*-----------------------------------------------------*/
+    writer_mutex.lock();
+    writer_run = false;
+    writer_mutex.unlock();
+    writer_cv.notify_one();
+    writer_thread.join();
+
+    if(request_pending)
+    {
+        ApplyEffect(request);
+    }
+
+    delete controller;
+
+    if(shutdown_callback)
+    {
+        shutdown_callback();
+    }
+}
+
+void RGBController_SinowealthKeyboard49::SetupZones()
+{
+    /*-----------------------------------------------------*\
+    | Key matrix as wired; the LED value is the key's       |
+    | position in a live frame (column-major)               |
+    \*-----------------------------------------------------*/
+    const char* const keys[SINOWEALTH_49_MATRIX_ROWS][K636_MATRIX_COLS] =
+    {
+        { KEY_EN_ESCAPE,       nullptr,             KEY_EN_F1,       KEY_EN_F2,      KEY_EN_F3,      KEY_EN_F4,      KEY_EN_F5,      KEY_EN_F6,      KEY_EN_F7,         KEY_EN_F8,            KEY_EN_F9,             KEY_EN_F10,          KEY_EN_F11,           KEY_EN_F12,             KEY_EN_PRINT_SCREEN,  KEY_EN_NUMPAD_PLUS,   KEY_EN_NUMPAD_MINUS  },
+        { KEY_EN_BACK_TICK,    KEY_EN_1,            KEY_EN_2,        KEY_EN_3,       KEY_EN_4,       KEY_EN_5,       KEY_EN_6,       KEY_EN_7,       KEY_EN_8,          KEY_EN_9,             KEY_EN_0,              KEY_EN_MINUS,        KEY_EN_EQUALS,        KEY_EN_BACKSPACE,       KEY_EN_NUMPAD_LOCK,   KEY_EN_NUMPAD_DIVIDE, KEY_EN_NUMPAD_TIMES  },
+        { KEY_EN_TAB,          KEY_EN_Q,            KEY_EN_W,        KEY_EN_E,       KEY_EN_R,       KEY_EN_T,       KEY_EN_Y,       KEY_EN_U,       KEY_EN_I,          KEY_EN_O,             KEY_EN_P,              KEY_EN_LEFT_BRACKET, KEY_EN_RIGHT_BRACKET, KEY_EN_ANSI_BACK_SLASH, KEY_EN_NUMPAD_7,      KEY_EN_NUMPAD_8,      KEY_EN_NUMPAD_9      },
+        { KEY_EN_CAPS_LOCK,    KEY_EN_A,            KEY_EN_S,        KEY_EN_D,       KEY_EN_F,       KEY_EN_G,       KEY_EN_H,       KEY_EN_J,       KEY_EN_K,          KEY_EN_L,             KEY_EN_SEMICOLON,      KEY_EN_QUOTE,        nullptr,              KEY_EN_ANSI_ENTER,      KEY_EN_NUMPAD_4,      KEY_EN_NUMPAD_5,      KEY_EN_NUMPAD_6      },
+        { KEY_EN_LEFT_SHIFT,   KEY_EN_Z,            KEY_EN_X,        KEY_EN_C,       KEY_EN_V,       KEY_EN_B,       KEY_EN_N,       KEY_EN_M,       KEY_EN_COMMA,      KEY_EN_PERIOD,        KEY_EN_FORWARD_SLASH,  KEY_EN_RIGHT_SHIFT,  nullptr,              KEY_EN_UP_ARROW,        KEY_EN_NUMPAD_1,      KEY_EN_NUMPAD_2,      KEY_EN_NUMPAD_3      },
+        { KEY_EN_LEFT_CONTROL, KEY_EN_LEFT_WINDOWS, KEY_EN_LEFT_ALT, nullptr,        nullptr,        KEY_EN_SPACE,   nullptr,        nullptr,        KEY_EN_RIGHT_ALT,  KEY_EN_RIGHT_CONTROL, KEY_EN_RIGHT_FUNCTION, nullptr,             KEY_EN_LEFT_ARROW,    KEY_EN_DOWN_ARROW,      KEY_EN_RIGHT_ARROW,   KEY_EN_NUMPAD_0,      KEY_EN_NUMPAD_PERIOD },
+    };
+
+    unsigned int matrix_map[SINOWEALTH_49_MATRIX_ROWS][K636_MATRIX_COLS];
+
+    leds.clear();
+    colors.clear();
+
+    for(unsigned int row = 0; row < SINOWEALTH_49_MATRIX_ROWS; row++)
+    {
+        for(unsigned int col = 0; col < K636_MATRIX_COLS; col++)
+        {
+            if(keys[row][col] == nullptr)
+            {
+                matrix_map[row][col] = NA;
+                continue;
+            }
+
+            matrix_map[row][col] = (unsigned int)leds.size();
+
+            led new_led;
+            new_led.name  = keys[row][col];
+            new_led.value = col * SINOWEALTH_49_MATRIX_ROWS + row;
+            leds.push_back(new_led);
+        }
+    }
+
+    zone keyboard_zone;
+    keyboard_zone.name       = ZONE_EN_KEYBOARD;
+    keyboard_zone.type       = ZONE_TYPE_MATRIX;
+    keyboard_zone.leds_min   = (unsigned int)leds.size();
+    keyboard_zone.leds_max   = (unsigned int)leds.size();
+    keyboard_zone.leds_count = (unsigned int)leds.size();
+    keyboard_zone.matrix_map.Set(SINOWEALTH_49_MATRIX_ROWS, K636_MATRIX_COLS, (unsigned int *)matrix_map);
+
+    zones.clear();
+    zones.push_back(keyboard_zone);
+
+    SetupColors();
+}
+
+void RGBController_SinowealthKeyboard49::DeviceUpdateLEDs()
+{
+    if(modes[active_mode].value != SINOWEALTH_49_MODE_DIRECT)
+    {
+        return;
+    }
+
+    /*-----------------------------------------------------*\
+    | Wait first, then build the frame from the newest      |
+    | colours                                               |
+    \*-----------------------------------------------------*/
+    controller->WaitForFrameSlot();
+
+    std::vector<unsigned char> frame(SINOWEALTH_49_FRAME_SIZE, 0x00);
+
+    for(unsigned int i = 0; i < leds.size(); i++)
+    {
+        unsigned int offset = leds[i].value * 3;
+
+        frame[offset]     = RGBGetRValue(colors[i]);
+        frame[offset + 1] = RGBGetGValue(colors[i]);
+        frame[offset + 2] = RGBGetBValue(colors[i]);
+    }
+
+    controller->SendFrame(frame);
+}
+
+void RGBController_SinowealthKeyboard49::DeviceUpdateZoneLEDs(int /*zone*/)
+{
+    DeviceUpdateLEDs();
+}
+
+void RGBController_SinowealthKeyboard49::DeviceUpdateSingleLED(int /*led*/)
+{
+    DeviceUpdateLEDs();
+}
+
+void RGBController_SinowealthKeyboard49::DeviceUpdateMode()
+{
+    mode&         current    = modes[active_mode];
+    unsigned char new_mode   = (unsigned char)current.value;
+    unsigned int  generation = ++update_generation;
+
+    if(new_mode == SINOWEALTH_49_MODE_DIRECT)
+    {
+        /*-------------------------------------------------*\
+        | Direct replaces any effect change still waiting   |
+        \*-------------------------------------------------*/
+        writer_mutex.lock();
+        request_pending = false;
+        writer_mutex.unlock();
+
+        state_mutex.lock();
+
+        if(device_mode != SINOWEALTH_49_MODE_DIRECT && controller->SetMode(SINOWEALTH_49_MODE_DIRECT, nullptr))
+        {
+            device_mode = SINOWEALTH_49_MODE_DIRECT;
+        }
+
+        state_mutex.unlock();
+
+        DeviceUpdateLEDs();
+        return;
+    }
+
+    effect_request req;
+    req.generation  = generation;
+    req.mode        = new_mode;
+    req.has_speed   = (current.flags & MODE_FLAG_HAS_SPEED) != 0;
+    req.speed       = (unsigned char)current.speed;
+    req.brightness  = (unsigned char)current.brightness;
+    req.random      = (current.color_mode == MODE_COLORS_RANDOM);
+    req.color       = (current.colors.size() > 0) ? current.colors[0] : default_palette[0];
+
+    if(!palette_known && !req.random)
+    {
+        /*-------------------------------------------------*\
+        | Without the keyboard's palette, only the default  |
+        | colours can be used; show the one that will be    |
+        \*-------------------------------------------------*/
+        req.color         = default_palette[NearestPaletteIndex(req.color)];
+        current.colors[0] = req.color;
+    }
+
+    writer_mutex.lock();
+    request         = req;
+    request_pending = true;
+    request_time    = std::chrono::steady_clock::now();
+    writer_mutex.unlock();
+
+    writer_cv.notify_one();
+}
+
+void RGBController_SinowealthKeyboard49::WriterThreadFunction()
+{
+    std::unique_lock<std::mutex> lock(writer_mutex);
+
+    while(writer_run)
+    {
+        if(!request_pending)
+        {
+            writer_cv.wait(lock);
+            continue;
+        }
+
+        std::chrono::steady_clock::time_point due = request_time + EFFECT_WRITE_DELAY;
+
+        if(std::chrono::steady_clock::now() < due)
+        {
+            writer_cv.wait_until(lock, due);
+            continue;
+        }
+
+        effect_request req = request;
+        request_pending    = false;
+
+        lock.unlock();
+        ApplyEffect(req);
+        lock.lock();
+    }
+}
+
+/*---------------------------------------------------------*\
+| Write an effect and its settings.  A colour that is not   |
+| in the effect's palette entry replaces the entry's first  |
+| colour, which means writing the palette block too         |
+\*---------------------------------------------------------*/
+void RGBController_SinowealthKeyboard49::ApplyEffect(const effect_request& req)
+{
+    std::lock_guard<std::mutex> lock(state_mutex);
+
+    if(req.generation != update_generation)
+    {
+        return;
+    }
+
+    sinowealth_49_effect_settings effect = device_effects[req.mode - 1];
+    unsigned char                 new_palette[SINOWEALTH_49_PALETTE_BLOCK_SIZE];
+    bool                          write_palette = false;
+
+    if(req.has_speed)
+    {
+        effect.speed = req.speed;
+    }
+
+    effect.brightness = req.brightness;
+
+    if(req.random)
+    {
+        effect.color_flag = SINOWEALTH_49_COLOR_RANDOM;
+    }
+    else if(!palette_known)
+    {
+        effect.color_flag = NearestPaletteIndex(req.color);
+    }
+    else if(effect.color_flag >= SINOWEALTH_49_PALETTE_SIZE || PaletteColor(req.mode, effect.color_flag) != req.color)
+    {
+        effect.color_flag = SINOWEALTH_49_PALETTE_SIZE;
+
+        for(unsigned char slot = 0; slot < SINOWEALTH_49_PALETTE_SIZE; slot++)
+        {
+            if(PaletteColor(req.mode, slot) == req.color)
+            {
+                effect.color_flag = slot;
+                break;
+            }
+        }
+
+        if(effect.color_flag == SINOWEALTH_49_PALETTE_SIZE)
+        {
+            unsigned int offset = req.mode * SINOWEALTH_49_PALETTE_ENTRY_SIZE;
+
+            memcpy(new_palette, device_palette, sizeof(new_palette));
+            new_palette[offset]     = RGBGetRValue(req.color);
+            new_palette[offset + 1] = RGBGetGValue(req.color);
+            new_palette[offset + 2] = RGBGetBValue(req.color);
+
+            effect.color_flag = 0;
+            write_palette     = true;
+        }
+    }
+
+    const sinowealth_49_effect_settings& stored = device_effects[req.mode - 1];
+
+    if(!write_palette
+    && device_mode       == req.mode
+    && stored.color_flag == effect.color_flag
+    && stored.speed      == effect.speed
+    && stored.brightness == effect.brightness)
+    {
+        return;
+    }
+
+    if(controller->SetMode(req.mode, &effect, write_palette ? new_palette : nullptr))
+    {
+        device_mode                  = req.mode;
+        device_effects[req.mode - 1] = effect;
+
+        if(write_palette)
+        {
+            memcpy(device_palette, new_palette, sizeof(device_palette));
+        }
+    }
+}
+
+RGBColor RGBController_SinowealthKeyboard49::PaletteColor(unsigned char effect, unsigned char slot)
+{
+    if(!palette_known)
+    {
+        return(default_palette[slot]);
+    }
+
+    unsigned int offset = effect * SINOWEALTH_49_PALETTE_ENTRY_SIZE + slot * 3;
+
+    return(ToRGBColor(device_palette[offset], device_palette[offset + 1], device_palette[offset + 2]));
+}
