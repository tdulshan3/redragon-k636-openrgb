+DetectedControllers DetectSinowealthKeyboard49(hid_device_info* info, const std::string& name)
+{
+    std::lock_guard<std::recursive_mutex> lock(sinowealth_registry_mutex);
+
+    static std::map<std::string, std::chrono::steady_clock::time_point> rejected_paths;
+
+    DetectedControllers                     detected_controllers;
+    std::string                             path = info->path;
+    std::chrono::steady_clock::time_point   now  = std::chrono::steady_clock::now();
+
+    /*-----------------------------------------------------*\
+    | PID 0049 is shared by several keyboards, and sending  |
+    | them the wrong protocol has bricked some.  Ask for    |
+    | the model ID with the probe the vendor app sends, and |
+    | only continue for known models.                       |
+    |                                                       |
+    | This detector runs once per vendor collection, and on |
+    | Linux they all share one path: probe each path once,  |
+    | and skip paths that failed the probe moments ago      |
+    \*-----------------------------------------------------*/
+    if(rejected_paths.count(path) != 0 && (now - rejected_paths[path]) < std::chrono::seconds(5))
+    {
+        return(detected_controllers);
+    }
+
+    if(!SinowealthClaimDevice(path))
+    {
+        return(detected_controllers);
+    }
+
+    hid_device*   dev      = hid_open_path(info->path);
+    unsigned char model_id = 0;
+
+    if(dev)
+    {
+        model_id = SinowealthKeyboard49Controller::ProbeModel(dev);
+    }
+
+    if(model_id == SINOWEALTH_49_MODEL_K636)
+    {
+        SinowealthKeyboard49Controller*     controller     = new SinowealthKeyboard49Controller(dev, info->path, "Redragon K636 Kitava");
+        RGBController_SinowealthKeyboard49* rgb_controller = new RGBController_SinowealthKeyboard49(controller, [path](){ SinowealthUnclaimDevice(path); });
+
+        detected_controllers.push_back(rgb_controller);
+    }
+    else
+    {
+        LOG_DEBUG("[%s] No known model at \"HID: %s\" (model ID 0x%02X)", name.c_str(), info->path, model_id);
+
+        if(dev)
+        {
+            hid_close(dev);
+        }
+
+        SinowealthUnclaimDevice(path);
+        rejected_paths[path] = now;
+    }
+
+    return(detected_controllers);
+}
