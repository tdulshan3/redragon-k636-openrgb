+/*---------------------------------------------------------*\
+| One key per physical device.  On Windows every top-level  |
+| collection has its own path, such as                      |
+|   \\?\hid#vid_258a&pid_0049&mi_01&col05                   |
+|     #8&2b3d5b1e&0&0004#{guid}                             |
+| The collection shows up as "&col05" and as the last       |
+| "&0004" of the instance ID; dropping both gives the same  |
+| key for every collection of one keyboard.  On Linux and   |
+| macOS the collections already share one path              |
+\*---------------------------------------------------------*/
+static std::string SinowealthDeviceKey(const char* path)
+{
+    std::string key   = path;
+    std::string lower = key;
+
+    std::transform(lower.begin(), lower.end(), lower.begin(), [](unsigned char c){ return (char)std::tolower(c); });
+
+    size_t col = lower.find("&col");
+
+    if(col == std::string::npos)
+    {
+        return(key);
+    }
+
+    size_t end = col + 4;
+
+    while(end < key.size() && std::isxdigit((unsigned char)key[end]))
+    {
+        end++;
+    }
+
+    key.erase(col, end - col);
+
+    size_t guid     = key.rfind('#');
+    size_t instance = (guid == std::string::npos || guid == 0) ? std::string::npos : key.rfind('#', guid - 1);
+    size_t last     = (guid == std::string::npos) ? std::string::npos : key.rfind('&', guid);
+
+    if(last != std::string::npos && instance != std::string::npos && last > instance)
+    {
+        key.erase(last, guid - last);
+    }
+
+    return(key);
+}
+
+/*---------------------------------------------------------*\
+| Feature report IDs declared in the report descriptor of   |
+| an open device.  On Windows hidapi rebuilds the           |
+| descriptor of the opened collection only, so this tells   |
+| which reports can be sent through that path.  Returns an  |
+| empty set if the descriptor can't be read                 |
+\*---------------------------------------------------------*/
+static std::set<unsigned char> SinowealthFeatureReportIDs(hid_device* dev)
+{
+    std::set<unsigned char> ids;
+
+#ifdef HID_API_MAKE_VERSION
+#if HID_API_VERSION >= HID_API_MAKE_VERSION(0, 14, 0)
+    unsigned char               desc[HID_API_MAX_REPORT_DESCRIPTOR_SIZE];
+    int                         size      = hid_get_report_descriptor(dev, desc, sizeof(desc));
+    int                         pos       = 0;
+    unsigned char               report_id = 0;
+    std::vector<unsigned char>  pushed_ids;
+
+    while(pos < size)
+    {
+        unsigned char prefix = desc[pos];
+
+        /*-------------------------------------------------*\
+        | Long item: prefix, data size, tag, data           |
+        \*-------------------------------------------------*/
+        if(prefix == 0xFE)
+        {
+            if(pos + 1 >= size)
+            {
+                break;
+            }
+
+            pos += 3 + desc[pos + 1];
+            continue;
+        }
+
+        int data_size = ((prefix & 0x03) == 0x03) ? 4 : (prefix & 0x03);
+
+        if(pos + data_size >= size)
+        {
+            break;
+        }
+
+        switch(prefix & 0xFC)
+        {
+            case 0x84:      // Report ID
+                if(data_size >= 1)
+                {
+                    report_id = desc[pos + 1];
+                }
+                break;
+
+            case 0xA4:      // Push
+                pushed_ids.push_back(report_id);
+                break;
+
+            case 0xB4:      // Pop
+                if(!pushed_ids.empty())
+                {
+                    report_id = pushed_ids.back();
+                    pushed_ids.pop_back();
+                }
+                break;
+
+            case 0xB0:      // Feature
+                ids.insert(report_id);
+                break;
+        }
+
+        pos += 1 + data_size;
+    }
+#endif
+#endif
+
+    return(ids);
+}
